<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.zerocreds.local-proxy</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__ROOT__/scripts/local-proxy.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ZEROCREDS_PROXY_PORT</key><string>__PORT__</string>
    <key>ZEROCREDS_PROXY_TARGET</key><string>__TARGET__</string>
    <key>ZEROCREDS_PROXY_HOST</key><string>localhost</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/var/log/zerocreds-proxy.log</string>
  <key>StandardErrorPath</key><string>/var/log/zerocreds-proxy-error.log</string>
</dict>
</plist>
